{
    "version": "1.0",
    "schema_version": "1.0",
    "system": {
        "workspace_dir": "forge_workspace",
        "log_dir": "forge_data/logs",
        "log_level": "INFO",
        "coverage_threshold": 90.0
    },
    "models": {
        "provider": "ollama",
        "default_model": "qwen2.5-coder:7b",
        "base_url": "http://localhost:11434",
        "temperature": 0.7,
        "max_tokens": 8192,
        "request_timeout": 900.0,
        "keep_alive": "30m"
    },
    "plugins": {
        "plugin_dir": "forge_plugins",
        "enabled_plugins": ["planner", "architect", "developer", "tester", "documentation", "git", "security", "reviewer"]
    },
    "git": {
        "auto_branch": true,
        "auto_commit": true,
        "auto_tag": true,
        "llm_commit_messages": false,
        "github_enabled": false,
        "github_token": "",
        "github_owner": "",
        "github_repo": "",
        "default_branch": "main",
        "branch_prefix": "forge"
    },
    "security": {
        "enabled": true,
        "secret_scan": true,
        "dependency_scan": true,
        "ast_scan": true,
        "license_scan": true,
        "llm_review": true,
        "block_release": true,
        "max_risk_score": 30.0,
        "max_high": 2,
        "max_critical": 0,
        "rules": {
            "SEC-001-EVAL": true,
            "SEC-002-EXEC": true,
            "SEC-003-SHELL": true,
            "SEC-004-PICKLE": true,
            "SEC-005-WEAKCRYPTO": true,
            "SEC-006-HARDCODED": true,
            "SEC-007-SQL": true,
            "SEC-008-TEMPFILE": true
        }
    },
    "reviewer": {
        "enabled": true,
        "llm_review": true,
        "block_release": false,
        "min_quality_score": 50.0,
        "rules": {
            "REV-001-LONGFUNC": true,
            "REV-002-TOOMANYPARAMS": true,
            "REV-003-GODCLASS": true,
            "REV-004-DEEPNESTING": true,
            "REV-005-MAGICNUMBER": true,
            "REV-006-NODOCSTRING": true,
            "REV-007-MUTABLEDEFAULT": true,
            "REV-008-TYPECHECKCHAIN": true,
            "REV-009-FATINTERFACE": true,
            "REV-010-CONCRETEDEP": true
        }
    }
}