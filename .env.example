# Copy this file to .env (already git-ignored) and fill in what you need.
# ForgeAI reads these directly from the process environment — none are
# required for a local run; the defaults in config/defaults.json apply
# whenever a variable is unset.

# Overrides system.workspace_dir — where generated project code is written.
# FORGE_WORKSPACE=forge_workspace

# Overrides system.log_level (DEBUG, INFO, WARNING, ERROR).
# FORGE_LOG_LEVEL=INFO

# Overrides models.default_model — must be an Ollama model tag you have pulled.
# FORGE_MODEL=qwen2.5-coder:7b

# Overrides models.request_timeout (seconds) — how long ForgeAI waits for a
# single LLM HTTP call before giving up. Default 900s already assumes slow,
# local CPU-bound inference; raise it further on very large models or modest
# hardware, or lower it if you're on GPU and want faster failure feedback.
# FORGE_REQUEST_TIMEOUT=900

# Overrides models.keep_alive — how long Ollama keeps the model loaded after
# a call before unloading it. Ollama's own default (5m) is shorter than the
# gap between this project's sequential pipeline stages, so every call past
# the first pays a full model reload. "30m" covers a full pipeline run;
# "-1" never unloads (fine on a dedicated dev machine, costly if you need
# that RAM back for other apps between runs).
# FORGE_KEEP_ALIVE=30m

# GitHub personal access token used by the Git plugin when git.github_enabled
# is true, to open pull requests via PyGithub. Prefer this over setting
# git.github_token in forge.json — env vars keep the secret out of any file
# on disk. Needs "repo" scope for a classic PAT, or Contents+Pull requests
# read/write for a fine-grained token.
# FORGE_GITHUB_TOKEN=
